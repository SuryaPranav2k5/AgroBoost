{
  "info": {
    "_postman_id": "agroboost-products-api",
    "name": "AgroBoost Products API",
    "description": "API collection for AgroBoost Products CRUD operations (Unit VI)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "user"
  },
  "item": [
    {
      "name": "Get All Products",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "AgroBoost-2024-Public-Catalog"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "12"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Search Products",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "AgroBoost-2024-Public-Catalog"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products?keyword=rice&categoryId=1&minPrice=50&maxPrice=200&page=1&pageSize=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"],
          "query": [
            {
              "key": "keyword",
              "value": "rice"
            },
            {
              "key": "categoryId",
              "value": "1"
            },
            {
              "key": "minPrice",
              "value": "50"
            },
            {
              "key": "maxPrice",
              "value": "200"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "10"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Product by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "AgroBoost-2024-Public-Catalog"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "1"]
        }
      },
      "response": []
    },
    {
      "name": "Create Product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "AgroBoost-2024-Public-Catalog"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sellerId\": \"seller-user-id-here\",\n  \"categoryId\": 1,\n  \"name\": \"Organic Basmati Rice\",\n  \"description\": \"Premium quality organic basmati rice grown without chemicals\",\n  \"unit\": \"kg\",\n  \"basePrice\": 120.00,\n  \"minOrderQty\": 5,\n  \"stockQty\": 100,\n  \"certifications\": \"FSSAI, Organic\",\n  \"shelfLifeDays\": 365\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"]
        }
      },
      "response": []
    },
    {
      "name": "Update Product",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "AgroBoost-2024-Public-Catalog"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 1,\n  \"sellerId\": \"seller-user-id-here\",\n  \"categoryId\": 1,\n  \"name\": \"Organic Basmati Rice (Updated)\",\n  \"description\": \"Premium quality organic basmati rice grown without chemicals - updated\",\n  \"unit\": \"kg\",\n  \"basePrice\": 130.00,\n  \"minOrderQty\": 5,\n  \"stockQty\": 80,\n  \"certifications\": \"FSSAI, Organic, ISO 22000\",\n  \"shelfLifeDays\": 365,\n  \"isActive\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/products/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "1"]
        }
      },
      "response": []
    },
    {
      "name": "Delete Product",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "AgroBoost-2024-Public-Catalog"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "1"]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:7000",
      "type": "string"
