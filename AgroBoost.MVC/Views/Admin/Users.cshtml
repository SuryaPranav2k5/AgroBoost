@model List<AgroBoost.MVC.Models.Domain.ApplicationUser>

@{
    ViewData["Title"] = "Manage Users";
    var userTypes = new[] { "Buyer", "Seller", "Admin" };
    var userTypeFilter = ViewBag.UserTypeFilter as string;
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var totalUsers = ViewBag.TotalUsers as int? ?? 0;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0"><i class="bi bi-people me-2"></i>Manage Users</h1>
        <a asp-action="Dashboard" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Filter by User Type</label>
                    <select name="userType" class="form-select" onchange="this.form.submit()">
                        <option value="">All Users</option>
                        @foreach (var type in userTypes)
                        {
                            <option value="@type" selected="@(userTypeFilter == type ? "selected" : null)">@type</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <a asp-action="Users" class="btn btn-outline-secondary w-100">Clear Filter</a>
                </div>
                <div class="col-md-4 text-md-end">
                    <span class="text-muted">@totalUsers user(s) found</span>
                </div>
            </form>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-person-x display-1 text-muted"></i>
            <h3 class="mt-3">No users found</h3>
            <p class="text-muted">No users matching the selected filter.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 22%;">User</th>
                                <th style="width: 10%;">Type</th>
                                <th style="width: 10%;">Organization</th>
                                <th style="width: 14%;">Location</th>
                                <th style="width: 10%;">Verified</th>
                                <th style="width: 10%;">Status</th>
                                <th style="width: 12%;">Registered</th>
                                <th style="width: 12%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                                <span class="fw-bold">@(string.IsNullOrEmpty(user.FullName) ? "?" : user.FullName[0].ToString())</span>
                                            </div>
                                            <div>
                                                <div class="fw-bold">@user.FullName</div>
                                                <small class="text-muted">@user.Email</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="badge bg-info text-dark">@user.UserType</span></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(user.OrganizationName))
                                        {
                                            <div>@user.OrganizationName</div>
                                        }
                                        @if (!string.IsNullOrEmpty(user.OrganizationType))
                                        {
                                            <small class="text-muted">@user.OrganizationType</small>
                                        }
                                        @if (string.IsNullOrEmpty(user.OrganizationName) && string.IsNullOrEmpty(user.OrganizationType))
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>@user.District, @user.State</td>
                                    <td>
                                        @if (user.IsVerified)
                                        {
                                            <span class="badge bg-success">Verified</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>@user.CreatedAt.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <form asp-action="ToggleUserStatus" method="post" class="d-inline">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                                    onclick="return confirm('@(user.IsActive ? "Deactivate" : "Activate") this user?')">
                                                <i class="bi bi-@(user.IsActive ? "person-x" : "person-check") me-1"></i>@(user.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (totalPages > 1)
        {
            <nav aria-label="Users pagination" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Users" asp-route-userType="@userTypeFilter" asp-route-page="@(currentPage - 1)">Previous</a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Users" asp-route-userType="@userTypeFilter" asp-route-page="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Users" asp-route-userType="@userTypeFilter" asp-route-page="@(currentPage + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
