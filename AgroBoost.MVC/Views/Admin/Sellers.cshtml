@model List<AgroBoost.MVC.Models.Domain.ApplicationUser>

@{
    ViewData["Title"] = "Manage Sellers";
}

<div class="container py-4">
    <h1 class="mb-4"><i class="bi bi-people-gear me-2"></i>Manage Sellers</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Filter by Verification</label>
                    <select name="status" class="form-select" onchange="this.form.submit()">
                        <option value="">All Sellers</option>
                        <option value="verified">Verified</option>
                        <option value="pending">Pending Verification</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <a asp-action="Sellers" class="btn btn-outline-secondary w-100">Clear Filter</a>
                </div>
            </form>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-people display-1 text-muted"></i>
            <h3 class="mt-3">No sellers found</h3>
            <p class="text-muted">No sellers matching the filter.</p>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 15%;">Seller</th>
                                <th style="width: 12%;">Type</th>
                                <th style="width: 12%;">Location</th>
                                <th style="width: 12%;">Products</th>
                                <th style="width: 10%;">Orders</th>
                                <th style="width: 12%;">Revenue</th>
                                <th style="width: 10%;">Status</th>
                                <th style="width: 12%;">Registered</th>
                                <th style="width: 7%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var seller in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                                <span class="fw-bold">@seller.FullName[0]</span>
                                            </div>
                                            <div>
                                                <div class="fw-bold">@seller.OrganizationName ?? seller.FullName</div>
                                                <small class="text-muted">@seller.Email</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(seller.OrganizationType))
                                        {
                                            <span class="badge bg-info text-dark">@seller.OrganizationType</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>@seller.District, @seller.State</td>
                                    <td>
                                        @{
                                            var productCount = seller.Products?.Count(p => p.IsActive) ?? 0;
                                        }
                                        <span class="fw-bold">@productCount</span>
                                    </td>
                                    <td>
                                        @{
                                            var orderCount = seller.OrdersAsSeller?.Count ?? 0;
                                        }
                                        @orderCount
                                    </td>
                                    <td>
                                        @{
                                            var revenue = seller.OrdersAsSeller?.Where(o => o.Status == "Delivered").Sum(o => o.TotalAmount) ?? 0;
                                        }
                                        <span class="fw-bold text-success">₹@revenue.ToString("N0")</span>
                                    </td>
                                    <td>
                                        @if (seller.IsVerified)
                                        {
                                            <span class="badge bg-success">Verified</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Pending</span>
                                        }
                                    </td>
                                    <td>@seller.CreatedAt.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @if (!seller.IsVerified)
                                        {
                                            <form asp-action="VerifySeller" method="post" class="d-inline">
                                                <input type="hidden" name="userId" value="@seller.Id" />
                                                <input type="hidden" name="verify" value="true" />
                                                <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('Verify this seller?')">
                                                    <i class="bi bi-check-circle me-1"></i>Verify
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="VerifySeller" method="post" class="d-inline">
                                                <input type="hidden" name="userId" value="@seller.Id" />
                                                <input type="hidden" name="verify" value="false" />
                                                <button type="submit" class="btn btn-sm btn-outline-warning" onclick="return confirm('Revoke verification for this seller?')">
                                                    <i class="bi bi-x-circle me-1"></i>Revoke
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>