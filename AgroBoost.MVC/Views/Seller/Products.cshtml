@model List<AgroBoost.MVC.Models.Domain.Product>

@{
    ViewData["Title"] = "My Products";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0"><i class="bi bi-box-seam me-2"></i>My Products</h1>
        <a asp-action="CreateProduct" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Add New Product</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-box display-1 text-muted"></i>
            <h3 class="mt-3">No products yet</h3>
            <p class="text-muted">Start selling by adding your first product.</p>
            <a asp-action="CreateProduct" class="btn btn-primary mt-2">Add Product</a>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 10%;">Image</th>
                                <th style="width: 30%;">Product</th>
                                <th style="width: 12%;">Category</th>
                                <th style="width: 10%;">Price</th>
                                <th style="width: 10%;">Stock</th>
                                <th style="width: 10%;">Min Qty</th>
                                <th style="width: 10%;">Status</th>
                                <th style="width: 10%;">Created</th>
                                <th style="width: 18%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model)
                            {
                                var imageUrl = string.IsNullOrEmpty(product.Images)
                                    ? "/images/product-placeholder.svg"
                                    : product.Images.Split(',')[0].Trim();

                                <tr>
                                    <td><img src="@imageUrl" alt="@product.Name" class="rounded" style="width: 50px; height: 50px; object-fit: cover;" /></td>
                                    <td><div class="fw-bold">@product.Name</div><small class="text-muted d-block">@product.Unit</small></td>
                                    <td>@product.Category?.Name</td>
                                    <td class="fw-bold text-primary">₹@product.BasePrice.ToString("N2")</td>
                                    <td>
                                        @if (product.StockQty > 0)
                                        {
                                            <span class="badge bg-success">@product.StockQty</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Out of Stock</span>
                                        }
                                    </td>
                                    <td>@product.MinOrderQty</td>
                                    <td>
                                        @if (product.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>@product.CreatedAt.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="EditProduct" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                            @if (product.IsActive)
                                            {
                                                <form asp-action="DeleteProduct" asp-route-id="@product.Id" method="post" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Deactivate this product?')" title="Deactivate"><i class="bi bi-eye-slash"></i></button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="EditProduct" asp-route-id="@product.Id" method="get" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Reactivate"><i class="bi bi-eye"></i></button>
                                                </form>
                                            }
                                            <a asp-controller="Order" asp-action="History" class="btn btn-sm btn-outline-info" title="View Orders"><i class="bi bi-list-ul"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>