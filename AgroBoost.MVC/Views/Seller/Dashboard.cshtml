@{
    ViewData["Title"] = "Seller Dashboard";
    var analytics = ViewBag.Analytics as AgroBoost.MVC.Models.DTOs.SellerAnalyticsDto;
    var recentOrders = ViewBag.RecentOrders as List<AgroBoost.MVC.Models.Domain.Order>;
    var totalProducts = ViewBag.TotalProducts as int? ?? 0;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0"><i class="bi bi-speedometer2 me-2"></i>Seller Dashboard</h1>
        <a asp-action="CreateProduct" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Add Product
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card stat-card text-center border-0 shadow-sm h-100">
                <div class="card-body">
                    <i class="bi bi-box-seam display-4 text-primary"></i>
                    <h3 class="fw-bold mt-2">@totalProducts</h3>
                    <p class="text-muted mb-0">Active Products</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card text-center border-0 shadow-sm h-100">
                <div class="card-body">
                    <i class="bi bi-currency-rupee display-4 text-success"></i>
                    <h3 class="fw-bold mt-2">₹@(analytics?.TotalRevenue.ToString("N0") ?? "0")</h3>
                    <p class="text-muted mb-0">Total Revenue</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card text-center border-0 shadow-sm h-100">
                <div class="card-body">
                    <i class="bi bi-bag-check display-4 text-warning"></i>
                    <h3 class="fw-bold mt-2">@(analytics?.CompletedOrders ?? 0)</h3>
                    <p class="text-muted mb-0">Completed Orders</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card text-center border-0 shadow-sm h-100">
                <div class="card-body">
                    <i class="bi bi-boxes display-4 text-info"></i>
                    <h3 class="fw-bold mt-2">@(analytics?.TotalInventoryUnits ?? 0)</h3>
                    <p class="text-muted mb-0">Inventory Units</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Monthly Revenue Chart (Table) -->
        <div class="col-lg-8">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-graph-up me-2"></i>Monthly Revenue Trend</h5>
                </div>
                <div class="card-body">
                    @if (analytics?.MonthlyRevenue != null && analytics.MonthlyRevenue.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Month</th>
                                        <th>Revenue</th>
                                        <th>Orders</th>
                                        <th>Cumulative</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var month in analytics.MonthlyRevenue)
                                    {
                                        <tr>
                                            <td>@month.Month</td>
                                            <td class="fw-bold text-success">₹@month.Revenue.ToString("N2")</td>
                                            <td>@month.Orders</td>
                                            <td class="fw-bold">₹@month.CumulativeRevenue.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-graph-up display-1"></i>
                            <p class="mt-2">No revenue data available yet</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Top Products & Order Funnel -->
        <div class="col-lg-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-star-fill me-2"></i>Top Products</h5>
                </div>
                <div class="card-body">
                    @if (analytics?.TopProducts != null && analytics.TopProducts.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Product</th>
                                        <th>Revenue</th>
                                        <th>Units</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in analytics.TopProducts)
                                    {
                                        <tr>
                                            <td>@product.ProductName</td>
                                            <td class="fw-bold text-success">₹@product.ProductRevenue.ToString("N2")</td>
                                            <td>@product.UnitsSold</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-3">No sales data yet</p>
                    }
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-funnel me-2"></i>Order Funnel</h5>
                </div>
                <div class="card-body">
                    @if (analytics?.OrderFunnel != null && analytics.OrderFunnel.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Status</th>
                                        <th>Count</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var funnel in analytics.OrderFunnel)
                                    {
                                        var badgeClass = funnel.Status switch
                                        {
                                            "Delivered" => "success",
                                            "Cancelled" => "danger",
                                            "Pending" => "warning",
                                            _ => "primary"
                                        };
                                        <tr>
                                            <td><span class="badge bg-@badgeClass">@funnel.Status</span></td>
                                            <td class="fw-bold">@funnel.Count</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-3">No orders yet</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Orders -->
    <div class="card shadow-sm mt-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Recent Orders</h5>
            <a asp-action="Orders" class="btn btn-sm btn-outline-primary">View All</a>
        </div>
        <div class="card-body p-0">
            @if (recentOrders != null && recentOrders.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Order #</th>
                                <th>Date</th>
                                <th>Buyer</th>
                                <th>Items</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in recentOrders.Take(10))
                            {
                                var badgeClass = order.Status switch
                                {
                                    "Delivered" => "success",
                                    "Cancelled" => "danger",
                                    "Pending" => "warning",
                                    _ => "primary"
                                };
                                <tr>
                                    <td><strong>@order.OrderNumber</strong></td>
                                    <td>@order.OrderDate.ToString("dd MMM yyyy")</td>
                                    <td>@order.Buyer?.FullName</td>
                                    <td>@order.Items.Count</td>
                                    <td class="fw-bold text-primary">₹@order.TotalAmount.ToString("N2")</td>
                                    <td><span class="badge bg-@badgeClass">@order.Status</span></td>
                                    <td>
                                        <a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-bag display-1"></i>
                    <p class="mt-2">No recent orders</p>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .stat-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .stat-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 30px rgba(0,0,0,0.15) !important;
    }
</style>