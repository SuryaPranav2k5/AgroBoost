@model List<AgroBoost.MVC.Models.Domain.Order>

@{
    ViewData["Title"] = "Manage Orders";
}

<div class="container py-4">
    <h1 class="mb-4"><i class="bi bi-list-check me-2"></i>Manage Orders</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-bag display-1 text-muted"></i>
            <h3 class="mt-3">No orders found</h3>
            <p class="text-muted">No orders matching the filter.</p>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 15%;">Order #</th>
                                <th style="width: 12%;">Date</th>
                                <th style="width: 15%;">Buyer</th>
                                <th style="width: 12%;">Items</th>
                                <th style="width: 12%;">Amount</th>
                                <th style="width: 12%;">Payment</th>
                                <th style="width: 10%;">Status</th>
                                <th style="width: 12%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td><strong>@order.OrderNumber</strong></td>
                                    <td>@order.OrderDate.ToString("dd MMM yyyy")<br /><small class="text-muted">@order.OrderDate.ToString("hh:mm tt")</small></td>
                                    <td><div class="fw-bold">@order.Buyer?.FullName</div><small class="text-muted">@order.Buyer?.Email</small></td>
                                    <td>@order.Items.Count item(s)</td>
                                    <td class="fw-bold text-primary">₹@order.TotalAmount.ToString("N2")</td>
                                    <td><span class="badge bg-secondary">@order.PaymentStatus</span></td>
                                    <td><span class="badge bg-primary">@order.Status</span></td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary" title="View Details"><i class="bi bi-eye"></i></a>
                                            <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" title="Update Status"><i class="bi bi-pencil"></i></button>
                                            <ul class="dropdown-menu">
                                                <li><a class="dropdown-item" href="#" onclick="updateStatus('@order.Id', 'Confirmed')">Confirm</a></li>
                                                <li><a class="dropdown-item" href="#" onclick="updateStatus('@order.Id', 'Processing')">Processing</a></li>
                                                <li><a class="dropdown-item" href="#" onclick="updateStatus('@order.Id', 'Shipped')">Ship</a></li>
                                                <li><a class="dropdown-item" href="#" onclick="updateStatus('@order.Id', 'Delivered')">Deliver</a></li>
                                                <li><hr class="dropdown-divider" /></li>
                                                <li><a class="dropdown-item text-danger" href="#" onclick="updateStatus('@order.Id', 'Cancelled')">Cancel</a></li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function updateStatus(orderId, status) {
            if (confirm('Update order status to "' + status + '"?')) {
                var form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Seller/UpdateOrderStatus/' + orderId;
                var statusInput = document.createElement('input');
                statusInput.type = 'hidden';
                statusInput.name = 'status';
                statusInput.value = status;
                form.appendChild(statusInput);
                var tokenInput = document.createElement('input');
                tokenInput.type = 'hidden';
                tokenInput.name = '__RequestVerificationToken';
                tokenInput.value = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                form.appendChild(tokenInput);
                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
}