@{
    ViewData["Title"] = "Order Confirmed";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="text-center mb-5">
                <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 3rem;"></i>
                </div>
                <h1 class="fw-bold">Order Confirmed!</h1>
                <p class="lead text-muted">Thank you for your order. We'll notify you via email and SMS.</p>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Order Details</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-6">
                            <small class="text-muted">Order Number</small>
                            <div class="fw-bold">@(ViewBag.OrderNumbers ?? "See My Orders for reference")</div>
                        </div>
                        <div class="col-6 text-end">
                            <small class="text-muted">Order Date</small>
                            <div class="fw-bold">@DateTime.Now.ToString("dd MMM yyyy")</div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <small class="text-muted">Payment Method</small>
                            <div class="fw-bold">@(ViewBag.PaymentMethod ?? "Cash on Delivery")</div>
                        </div>
                        <div class="col-6 text-end">
                            <small class="text-muted">Order Status</small>
                            <div class="fw-bold text-primary">Pending Confirmation</div>
                        </div>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between fw-bold fs-5">
                        <span>Order Total</span>
                        <span class="text-primary">₹@(((decimal)(ViewBag.OrderTotal ?? 0M)).ToString("N2"))</span>
                    </div>
                    <small class="text-muted">Payment will be collected on delivery</small>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0">What happens next?</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-4 mb-3">
                            <div class="bg-primary bg-opacity-10 rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                <i class="bi bi-check-circle text-primary fs-4"></i>
                            </div>
                            <strong>Order Received</strong>
                            <p class="text-muted small mb-0">Seller has been notified</p>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="bg-secondary bg-opacity-10 rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                <i class="bi bi-truck text-secondary fs-4"></i>
                            </div>
                            <strong>Processing</strong>
                            <p class="text-muted small mb-0">Seller prepares your order</p>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="bg-secondary bg-opacity-10 rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                <i class="bi bi-box text-secondary fs-4"></i>
                            </div>
                            <strong>Delivery</strong>
                            <p class="text-muted small mb-0">Order shipped to you</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-center mt-4">
                <a asp-controller="Order" asp-action="History" class="btn btn-primary me-2">
                    <i class="bi bi-list-ul me-1"></i>View My Orders
                </a>
                <a asp-controller="Home" asp-action="Search" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Continue Shopping
                </a>
            </div>
        </div>
    </div>
</div>