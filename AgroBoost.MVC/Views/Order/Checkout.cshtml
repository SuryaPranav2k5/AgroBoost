@model CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
    var totalAmount = ViewBag.TotalAmount as decimal? ?? 0;
    var sellerName = ViewBag.SellerName as string;
}

<div class="container py-4">
    <h1 class="mb-4"><i class="bi bi-credit-card-fill me-2"></i>Checkout</h1>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-controller="Order" asp-action="Checkout" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <!-- Order Items Summary -->
            <div class="col-lg-8">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Order Items</h5>
                    </div>
                    <div class="card-body p-0">
                        @foreach (var item in Model.CartItems)
                        {
                            var itemTotal = item.Product.BasePrice * item.Quantity;
                            <div class="border-bottom py-3 px-4 d-flex align-items-center">
                                <img src="@(string.IsNullOrEmpty(item.Product.Images) ? "/images/product-placeholder.svg" : item.Product.Images.Split(',')[0].Trim())" 
                                     alt="@item.Product.Name" class="rounded me-3" style="width: 50px; height: 50px; object-fit: cover;" />
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">@item.Product.Name</h6>
                                    <small class="text-muted">₹@item.Product.BasePrice.ToString("N2") / @item.Product.Unit × @item.Quantity</small>
                                </div>
                                <span class="fw-bold text-primary">₹@itemTotal.ToString("N2")</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Shipping Address -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><i class="bi bi-geo-alt-fill me-2"></i>Shipping Address</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="BuyerName" class="form-label">Full Name *</label>
                                <input asp-for="BuyerName" class="form-control" />
                                <span asp-validation-for="BuyerName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="BuyerPhone" class="form-label">Phone Number *</label>
                                <input asp-for="BuyerPhone" class="form-control" />
                                <span asp-validation-for="BuyerPhone" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="BuyerEmail" class="form-label">Email *</label>
                                <input asp-for="BuyerEmail" class="form-control" />
                                <span asp-validation-for="BuyerEmail" class="text-danger"></span>
                            </div>
                            <div class="col-12 mb-3">
                                <label asp-for="ShippingAddress" class="form-label">Full Address *</label>
                                <textarea asp-for="ShippingAddress" class="form-control" rows="3" placeholder="House/Flat No., Street, Area, City, State, PIN"></textarea>
                                <span asp-validation-for="ShippingAddress" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Payment Method -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><i class="bi bi-cash-stack me-2"></i>Payment Method</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="PaymentMethod" id="cod" value="Cash on Delivery" checked />
                            <label class="form-check-label fw-bold" for="cod">
                                <i class="bi bi-cash-coin me-2"></i>Cash on Delivery (COD)
                            </label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="PaymentMethod" id="bank" value="Bank Transfer" />
                            <label class="form-check-label fw-bold" for="bank">
                                <i class="bi bi-bank me-2"></i>Bank Transfer (NEFT/IMPS)
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="PaymentMethod" id="upi" value="UPI" />
                            <label class="form-check-label fw-bold" for="upi">
                                <i class="bi bi-phone me-2"></i>UPI Payment
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Order Notes -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><i class="bi bi-chat-left-text me-2"></i>Order Notes (Optional)</h5>
                    </div>
                    <div class="card-body">
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Any special instructions for the seller..."></textarea>
                    </div>
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="bi bi-check-circle me-2"></i>Place Order - ₹@totalAmount.ToString("N2")
                    </button>
                </div>
            </div>

            <!-- Order Summary Sidebar -->
            <div class="col-lg-4">
                <div class="card shadow-sm sticky-top" style="top: 100px;">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Order Summary</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-3">Seller: <strong>@sellerName</strong></p>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal</span>
                            <span class="fw-bold">₹@totalAmount.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Shipping</span>
                            <span class="text-success fw-bold">Free</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tax (GST)</span>
                            <span>Included</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between fw-bold fs-5 mb-3">
                            <span>Total Payable</span>
                            <span class="text-primary">₹@totalAmount.ToString("N2")</span>
                        </div>

                        <div class="alert alert-info small">
                            <i class="bi bi-info-circle me-1"></i>
                            Payment will be collected on delivery (COD) or as per selected method.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>