@model List<AgroBoost.MVC.Models.Domain.Order>

@{
    ViewData["Title"] = "Order History";
}

<div class="container py-4">
    <h1 class="mb-4"><i class="bi bi-clock-history me-2"></i>Order History</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-bag-x display-1 text-muted"></i>
            <h3 class="mt-3">No orders yet</h3>
            <p class="text-muted">You haven't placed any orders yet.</p>
            <a asp-controller="Home" asp-action="Search" class="btn btn-primary mt-2">Start Shopping</a>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 15%;">Order Number</th>
                                <th style="width: 12%;">Date</th>
                                <th style="width: 15%;">Seller</th>
                                <th style="width: 10%;">Items</th>
                                <th style="width: 15%;">Amount</th>
                                <th style="width: 15%;">Status</th>
                                <th style="width: 10%;">Payment</th>
                                <th style="width: 13%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td><strong>@order.OrderNumber</strong></td>
                                    <td>@order.OrderDate.ToString("dd MMM yyyy")<br /><small class="text-muted">@order.OrderDate.ToString("hh:mm tt")</small></td>
                                    <td><div class="fw-bold">@order.Buyer?.FullName</div><small class="text-muted">@order.Buyer?.Email</small></td>
                                    <td>@order.Items.Count item(s)</td>
                                    <td class="fw-bold text-primary">₹@order.TotalAmount.ToString("N2")</td>
                                    <td><span class="badge bg-primary">@order.Status</span></td>
                                    <td><span class="badge bg-secondary">@order.PaymentStatus</span></td>
                                    <td><a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i> View</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>