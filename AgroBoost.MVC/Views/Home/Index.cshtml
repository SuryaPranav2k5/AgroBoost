@{
    ViewData["Title"] = "AgroBoost - Enhancing Value Addition for Agriculture Products";
}

<!-- Hero Section -->
<section class="hero-section bg-primary text-white py-5">
    <div class="container-fluid">
        <div class="row align-items-center g-4">
            <div class="col-lg-7 hero-content">
                <h1 class="fw-bold mb-3">AgroBoost</h1>
                <p class="lead mb-4">Enhancing Value Addition for Agriculture Products by SHGs and FPGs</p>
                <p class="mb-4">Connect with verified Self Help Groups and Farmer Producer Groups for quality processed agricultural products.</p>
                <div class="hero-actions">
                    <a asp-controller="Home" asp-action="Search" class="btn btn-light">Browse Products</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light">Register as Seller</a>
                </div>
            </div>
            <div class="col-lg-5 hero-visual d-none d-lg-block">
                <div class="icon-box">
                    <img src="~/images/tractor.jpg" alt="Tractor working in an agricultural field" />
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Categories Section -->
<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Shop by Category</h2>
            <p class="text-muted">Explore our wide range of agricultural products</p>
        </div>
        
        @if (ViewBag.Categories != null && ViewBag.Categories.Count > 0)
        {
            <div class="row g-3">
                @foreach (var category in ViewBag.Categories)
                {
                    <div class="col-6 col-md-4 col-lg-2">
                        <a asp-controller="Home" asp-action="Search" asp-route-categoryId="@category.Id" class="text-decoration-none text-dark">
                            <div class="category-card card h-100 border-0 shadow-sm hover-shadow transition">
                                <div class="card-body text-center p-3">
                                    @{
                                        var categoryImage = category.Name switch
                                        {
                                            "Fruits & Vegetables" => "fruits-vegetables.jpg",
                                            "Dairy Products" => "dairy-products.jpg",
                                            "Grains & Cereals" => "grains-cereals.jpg",
                                            "Oilseeds & Oils" => "oilseeds-oils.jpg",
                                            "Organic Products" => "organic-products.jpg",
                                            "Processed Foods" => "processed-foods.jpg",
                                            "Pulses & Lentils" => "pulses-lentils.jpg",
                                            "Spices & Condiments" => "spices-condiments.jpg",
                                            _ => ""
                                        };
                                    }
                                    <img src="@Url.Content($"~/images/categories/{categoryImage}?v={DateTime.Now.Ticks}")"
                                         alt="@category.Name"
                                         class="category-icon mx-auto" 
                                         style="width: 140px; height: 140px; object-fit: contain;" />
                                    <h6 class="category-name">@category.Name</h6>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</section>

<!-- Featured Products Section -->
<section class="bg-light py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold mb-0">Featured Products</h2>
            <a asp-controller="Home" asp-action="Search" class="btn btn-outline-primary">View All Products</a>
        </div>

        @if (ViewData["FeaturedProducts"] is List<AgroBoost.MVC.Models.Domain.Product> featuredProducts && featuredProducts.Count > 0)
        {
            <div class="row g-4">
                @foreach (var product in featuredProducts)
                {
                    <partial name="~/Views/Product/_ProductCard.cshtml" model="product" />
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-box-seam display-1 text-muted"></i>
                <h4 class="mt-3">No products available yet</h4>
                <p class="text-muted">Be the first to add products as a seller!</p>
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary">Register as Seller</a>
            </div>
        }
    </div>
</section>

<!-- Stats Section -->
<section class="py-5 border-top">
    <div class="container">
        <div class="row text-center g-4">
            <div class="col-md-3">
                <div class="stat-card p-3">
                    <i class="bi bi-people-fill display-4 text-primary"></i>
                    <h3 class="fw-bold mt-2">500+</h3>
                    <p class="text-muted">Verified Sellers</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card p-3">
                    <i class="bi bi-box-fill display-4 text-success"></i>
                    <h3 class="fw-bold mt-2">2000+</h3>
                    <p class="text-muted">Quality Products</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card p-3">
                    <i class="bi bi-truck-fill display-4 text-warning"></i>
                    <h3 class="fw-bold mt-2">5000+</h3>
                    <p class="text-muted">Orders Delivered</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card p-3">
                    <i class="bi bi-shield-fill-check display-4 text-info"></i>
                    <h3 class="fw-bold mt-2">100%</h3>
                    <p class="text-muted">Quality Assured</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta-section text-white py-5">
    <div class="container text-center">
        <h2 class="fw-bold mb-3">Join AgroBoost Today</h2>
        <p class="lead mb-4">Whether you're a buyer looking for quality products or a seller wanting to reach more customers</p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-controller="Account" asp-action="Register" asp-route-userType="Buyer" class="btn btn-light btn-lg px-4">Register as Buyer</a>
            <a asp-controller="Account" asp-action="Register" asp-route-userType="SHG" class="btn btn-outline-light btn-lg px-4">Register as SHG/FPG</a>
        </div>
    </div>
</section>