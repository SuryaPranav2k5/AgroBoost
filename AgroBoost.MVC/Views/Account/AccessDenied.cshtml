@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <i class="bi bi-shield-lock display-1 text-danger"></i>
            <h1 class="fw-bold mt-3">Access Denied</h1>
            <p class="text-muted">
                Your account does not have permission to open this page.
                If you believe this is a mistake, please contact the administrator.
            </p>
            <div class="d-flex justify-content-center gap-2 mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to Home</a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary">Sign in as another user</a>
            </div>
        </div>
    </div>
</div>
