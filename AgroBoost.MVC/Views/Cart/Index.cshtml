@model List<AgroBoost.MVC.Models.Domain.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
    var totalAmount = Model?.Sum(c => c.Product.BasePrice * c.Quantity) ?? 0;
}

<div class="container py-4">
    <h1 class="mb-4"><i class="bi bi-cart-fill me-2"></i>Shopping Cart</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x display-1 text-muted"></i>
            <h3 class="mt-3">Your cart is empty</h3>
            <p class="text-muted">Looks like you haven't added any products yet.</p>
            <a asp-controller="Home" asp-action="Search" class="btn btn-primary mt-2">Continue Shopping</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Cart Items (@Model.Count)</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 40%;">Product</th>
                                        <th style="width: 15%;">Price</th>
                                        <th style="width: 20%;">Quantity</th>
                                        <th style="width: 15%;">Total</th>
                                        <th style="width: 10%;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        var itemTotal = item.Product.BasePrice * item.Quantity;
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <img src="@(string.IsNullOrEmpty(item.Product.Images) ? "/images/product-placeholder.svg" : item.Product.Images.Split(',')[0].Trim())" 
                                                         alt="@item.Product.Name" class="rounded me-3" style="width: 60px; height: 60px; object-fit: cover;" />
                                                    <div>
                                                        <h6 class="mb-1">@item.Product.Name</h6>
                                                        <small class="text-muted">Sold by @(item.Product.Seller?.OrganizationName ?? item.Product.Seller?.FullName)</small>
                                                        @if (!string.IsNullOrEmpty(item.Product.Seller?.OrganizationType))
                                                        {
                                                            <span class="badge bg-info text-dark ms-1">@item.Product.Seller.OrganizationType</span>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="align-middle">
                                                <span class="fw-bold">₹@item.Product.BasePrice.ToString("N2")</span>
                                                <small class="text-muted d-block">/ @item.Product.Unit</small>
                                            </td>
                                            <td class="align-middle">
                                                <form asp-controller="Cart" asp-action="Update" method="post" class="d-flex align-items-center gap-2">
                                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                                    <input type="number" name="quantity" class="form-control form-control-sm" style="width: 80px;" value="@item.Quantity" min="1" max="@item.Product.StockQty" />
                                                    <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
                                                </form>
                                            </td>
                                            <td class="align-middle">
                                                <span class="fw-bold text-primary fs-5">₹@itemTotal.ToString("N2")</span>
                                            </td>
                                            <td class="align-middle">
                                                <form asp-controller="Cart" asp-action="Remove" method="post" class="d-inline">
                                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Remove this item from cart?')">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer bg-white d-flex justify-content-between">
                        <a asp-controller="Home" asp-action="Search" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Continue Shopping
                        </a>
                        <form asp-controller="Cart" asp-action="Clear" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Clear entire cart?')">
                                <i class="bi bi-trash me-1"></i>Clear Cart
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm sticky-top" style="top: 100px;">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Order Summary</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal (@Model.Count items)</span>
                            <span class="fw-bold">₹@totalAmount.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Shipping</span>
                            <span class="text-success fw-bold">Free</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tax (GST)</span>
                            <span>Included</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between fw-bold fs-5 mb-3">
                            <span>Total</span>
                            <span class="text-primary">₹@totalAmount.ToString("N2")</span>
                        </div>
                        <a asp-controller="Order" asp-action="Checkout" class="btn btn-primary btn-lg w-100">
                            <i class="bi bi-credit-card me-2"></i>Proceed to Checkout
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>